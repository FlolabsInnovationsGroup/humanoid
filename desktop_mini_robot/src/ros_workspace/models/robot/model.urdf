<?xml version="1.0"?>
<!--
  Desktop Mini Robot - URDF Model
  Robot components (all dimensions in meters):
    - base_link   : wheels bridge  10cm(Y) × 1cm(X) × 1cm(Z)
    - left_wheel  : cylinder  radius=3cm, width=2cm
    - right_wheel : cylinder  radius=3cm, width=2cm
    - second_bridge : box  2cm(X) × 2cm(Y) × 1cm(Z)
    - body          : box  4cm(X) × 8cm(Y) × 14cm(Z)
    - infrared_sensor : box  0.45cm(X) × 0.20cm(Y) × 0.15cm(Z)

  Coordinate convention (base_link frame):
    X  - forward/backward (robot depth)
    Y  - left/right (robot width)
    Z  - up/down

  Spawn the robot with Z offset = 0.03 m (wheel radius) so wheels rest on the ground.
-->
<robot name="desktop_mini_robot">

  <!-- ======================================================= -->
  <!--  MATERIALS                                              -->
  <!-- ======================================================= -->
  <material name="black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>

  <material name="dark_grey">
    <color rgba="0.3 0.3 0.3 1.0"/>
  </material>

  <material name="blue">
    <color rgba="0.0 0.3 0.8 1.0"/>
  </material>

  <!-- ======================================================= -->
  <!--  LINKS                                                  -->
  <!-- ======================================================= -->

  <!--
    BASE LINK: Wheels Bridge (10cm × 1cm × 1cm)
    Main axle structure connecting both wheels.
    Its center sits at the same height as the wheel centers (= wheel radius above ground).
  -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.10 0.01"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.10 0.01"/>
      </geometry>
    </collision>
  </link>

  <!--
    LEFT WHEEL (diameter 6cm, width 2cm)
    Cylinder geometry rotated 90° around X so its axis aligns with the Y (lateral) axis.
    Inertia defined with cylinder axis along Y.
  -->
  <link name="left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.02"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.02"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <!-- Cylinder axis along Y: Iyy=mr²/2, Ixx=Izz=m(3r²+h²)/12 -->
      <!-- r=0.03, h=0.02 -->
      <inertia ixx="1.29e-5" ixy="0.0" ixz="0.0"
               iyy="2.25e-5" iyz="0.0"
               izz="1.29e-5"/>
    </inertial>
  </link>

  <!--
    RIGHT WHEEL (diameter 6cm, width 2cm)
    Same geometry and inertia as left_wheel.
  -->
  <link name="right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.02"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.02"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="1.29e-5" ixy="0.0" ixz="0.0"
               iyy="2.25e-5" iyz="0.0"
               izz="1.29e-5"/>
    </inertial>
  </link>

  <!--
    SECOND BRIDGE (2cm × 2cm × 1cm)
    Vertical connector between the wheels bridge and the body.
  -->
  <link name="second_bridge">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.01"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.01"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <!-- a=0.02(X), b=0.02(Y), c=0.01(Z) -->
      <inertia ixx="4.17e-7" ixy="0.0" ixz="0.0"
               iyy="4.17e-7" iyz="0.0"
               izz="6.67e-7"/>
    </inertial>
  </link>

  <!--
    BODY (4cm(X) × 8cm(Y) × 14cm(Z))
    Main robot enclosure sitting above the second bridge.
  -->
  <link name="body">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.08 0.14"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.08 0.14"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.20"/>
      <!-- a=0.04(X), b=0.08(Y), c=0.14(Z) -->
      <inertia ixx="4.33e-4" ixy="0.0" ixz="0.0"
               iyy="3.53e-4" iyz="0.0"
               izz="1.33e-4"/>
    </inertial>
  </link>

  <!--
    INFRARED SENSOR (0.45cm(X) × 0.20cm(Y) × 0.15cm(Z))
    Positioned at the center bottom of the wheels bridge, pointing downward.
    Used for surface / line detection.
  -->
  <link name="infrared_sensor">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.0045 0.0020 0.0015"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.0045 0.0020 0.0015"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.005"/>
      <!-- a=0.0045(X), b=0.0020(Y), c=0.0015(Z) -->
      <inertia ixx="2.60e-9" ixy="0.0" ixz="0.0"
               iyy="9.38e-9" iyz="0.0"
               izz="1.01e-8"/>
    </inertial>
  </link>

  <!-- ======================================================= -->
  <!--  JOINTS                                                 -->
  <!-- ======================================================= -->

  <!--
    LEFT WHEEL JOINT
    Wheel center Y offset: half bridge (0.05m) + half wheel width (0.01m) = 0.06m
  -->
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0.0 0.06 0.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!--
    RIGHT WHEEL JOINT
    Mirror of the left wheel joint.
  -->
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0.0 -0.06 0.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!--
    SECOND BRIDGE JOINT
    Z offset: half wheels bridge height (0.005m) + half second bridge height (0.005m) = 0.01m
  -->
  <joint name="second_bridge_joint" type="fixed">
    <parent link="base_link"/>
    <child link="second_bridge"/>
    <origin xyz="0.0 0.0 0.01" rpy="0 0 0"/>
  </joint>

  <!--
    BODY JOINT
    Z offset: half second bridge height (0.005m) + half body height (0.07m) = 0.075m
  -->
  <joint name="body_joint" type="fixed">
    <parent link="second_bridge"/>
    <child link="body"/>
    <origin xyz="0.0 0.0 0.075" rpy="0 0 0"/>
  </joint>

  <!--
    INFRARED SENSOR JOINT
    Z offset: -(half wheels bridge height + half sensor height) = -(0.005 + 0.00075) = -0.00575m
    Sensor hangs below the center of the wheels bridge.
  -->
  <joint name="infrared_joint" type="fixed">
    <parent link="base_link"/>
    <child link="infrared_sensor"/>
    <origin xyz="0.0 0.0 -0.00575" rpy="0 0 0"/>
  </joint>

  <!-- ======================================================= -->
  <!--  GAZEBO EXTENSIONS                                      -->
  <!-- ======================================================= -->

  <!--
    Differential Drive Plugin (Gazebo Harmonic)
    Wheel separation = 2 × 0.06m = 0.12m (center-to-center)
    Wheel radius = 0.03m
    Subscribes to: /cmd_vel  (geometry_msgs/Twist)
    Publishes to:  /odom     (nav_msgs/Odometry)
  -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.12</wheel_separation>
      <wheel_radius>0.03</wheel_radius>
      <odom_publish_frequency>10</odom_publish_frequency>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <min_acceleration>-5</min_acceleration>
      <max_acceleration>5</max_acceleration>
    </plugin>
  </gazebo>

  <!-- Joint state publisher - broadcasts wheel positions to /joint_states -->
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>
  </gazebo>

  <!-- Wheels bridge visual material -->
  <gazebo reference="base_link">
    <visual>
      <material>
        <ambient>0.1 0.1 0.1 1</ambient>
        <diffuse>0.1 0.1 0.1 1</diffuse>
        <specular>0.2 0.2 0.2 1</specular>
      </material>
    </visual>
  </gazebo>

  <!-- Left wheel: dark rubber-like material with friction -->
  <gazebo reference="left_wheel">
    <mu1>1.0</mu1>
    <mu2>0.5</mu2>
    <visual>
      <material>
        <ambient>0.3 0.3 0.3 1</ambient>
        <diffuse>0.3 0.3 0.3 1</diffuse>
        <specular>0.1 0.1 0.1 1</specular>
      </material>
    </visual>
  </gazebo>

  <!-- Right wheel: dark rubber-like material with friction -->
  <gazebo reference="right_wheel">
    <mu1>1.0</mu1>
    <mu2>0.5</mu2>
    <visual>
      <material>
        <ambient>0.3 0.3 0.3 1</ambient>
        <diffuse>0.3 0.3 0.3 1</diffuse>
        <specular>0.1 0.1 0.1 1</specular>
      </material>
    </visual>
  </gazebo>

  <!-- Second bridge visual material -->
  <gazebo reference="second_bridge">
    <visual>
      <material>
        <ambient>0.1 0.1 0.1 1</ambient>
        <diffuse>0.1 0.1 0.1 1</diffuse>
        <specular>0.2 0.2 0.2 1</specular>
      </material>
    </visual>
  </gazebo>

  <!-- Body visual material -->
  <gazebo reference="body">
    <visual>
      <material>
        <ambient>0.1 0.1 0.1 1</ambient>
        <diffuse>0.1 0.1 0.1 1</diffuse>
        <specular>0.2 0.2 0.2 1</specular>
      </material>
    </visual>
  </gazebo>

  <!--
    Infrared sensor: blue visual + single-ray sensor pointing downward.
    The sensor ray shoots along the local +X axis; pitch=π/2 rotates it toward -Z (ground).
    Range: 5mm – 150mm (typical IR proximity range for surface detection).
    Topic: /ir_sensor  (sensor_msgs/LaserScan via ros_gz_bridge)
    Note: the Sensors system plugin must be loaded in the world SDF:
          <plugin name='gz::sim::systems::Sensors' filename='gz-sim-sensors-system'>
            <render_engine>ogre2</render_engine>
          </plugin>
  -->
  <gazebo reference="infrared_sensor">
    <visual>
      <material>
        <ambient>0.0 0.3 0.8 1</ambient>
        <diffuse>0.0 0.3 0.8 1</diffuse>
        <specular>0.1 0.1 0.5 1</specular>
      </material>
    </visual>
    <sensor name="ir_sensor" type="gpu_lidar">
      <pose>0 0 0 0 1.5708 0</pose>
      <topic>ir_sensor</topic>
      <update_rate>20</update_rate>
      <always_on>1</always_on>
      <visualize>false</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.005</min>
          <max>0.15</max>
          <resolution>0.001</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>

</robot>
