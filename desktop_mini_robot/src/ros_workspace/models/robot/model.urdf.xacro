<?xml version="1.0"?>
<robot name="desktop_mini_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

<!-- Body dimensions -->
<xacro:property name="body_link_x_dim" value="0.04"/>
<xacro:property name="body_link_y_dim" value="0.08"/>
<xacro:property name="body_link_z_dim" value="0.1"/>

<!-- Base dimensions -->
<xacro:property name="base_link_x_dim" value="0.1"/>
<xacro:property name="base_link_y_dim" value="0.1"/>
<xacro:property name="base_link_z_dim" value="0.02"/>

<!-- Wheel dimensions -->
<xacro:property name="wheel_link_radius" value="0.02"/>
<xacro:property name="wheel_link_length" value="0.02"/>
<xacro:property name="wheel_link_z_location" value="0"/>

<!-- Material density -->
<xacro:property name="base_density" value="2710.0"/>
<xacro:property name="wheel_density" value="2710.0"/>

<!-- Pi constant -->
<xacro:property name="pi" value="3.1415926535"/>

<!-- Robot base and wheel mass  -->
<xacro:property name="base_mass" value="${base_density*base_link_x_dim*base_link_y_dim*base_link_z_dim}"/>
<xacro:property name="wheel_mass" value="${wheel_density*wheel_link_radius*wheel_link_radius*pi*wheel_link_length}"/>

<!-- Moments of inertia of the wheel -->
<xacro:property name="iz_wheel" value="${0.5*wheel_mass*wheel_link_radius*wheel_link_radius}"/>
<xacro:property name="i_wheel" value="${(1.0/12.0)*wheel_mass*(3*wheel_link_radius*wheel_link_radius+wheel_link_length*wheel_link_length)}"/>
<xacro:macro name="inertia_wheel">
  <inertial>
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <mass value="${wheel_mass}"/>
    <inertia ixx="${i_wheel}" ixy="0" ixz="0" iyx="0" iyy="${i_wheel}" iyz="0" izx="0" izy="0" izz="${iz_wheel}"/>
  </inertial>
</xacro:macro>

<link name="dummy">
</link>
<joint name="dummy_joint" type="fixed">
    <parent link="dummy"/>
    <child link="base_link"/>
</joint>

<!-- Base link -->
<link name="base_link">
  <visual>
    <geometry>
        <box size="${base_link_x_dim} ${base_link_y_dim} ${base_link_z_dim}"/>
    </geometry>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </visual>
  <collision>
    <geometry>
        <box size="${base_link_x_dim} ${base_link_y_dim} ${base_link_z_dim}"/>
    </geometry>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </collision>
  <inertial>
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <mass value="${base_mass}"/>
    <inertia ixx="${1.0/12.0*base_mass*(base_link_y_dim*base_link_y_dim+base_link_z_dim*base_link_z_dim)}" ixy="0" ixz="0" iyx="0" iyy="${1.0/12.0*base_mass*(base_link_x_dim*base_link_x_dim+base_link_z_dim*base_link_z_dim)}" iyz="0" izx="0" izy="0" izz="${1.0/12.0*base_mass*(base_link_x_dim*base_link_x_dim+base_link_y_dim*base_link_y_dim)}"/>
  </inertial>
</link>

<!-- Body link and joint -->
<joint name="body_joint" type="fixed">
    <parent link="base_link"/>
    <child link="body_link"/>
    <origin xyz="0 0 ${base_link_z_dim/2 + body_link_z_dim/2}" rpy="0 0 0"/>
</joint>
<link name="body_link">
  <visual>
    <geometry>
        <box size="${body_link_x_dim} ${body_link_y_dim} ${body_link_z_dim}"/>
    </geometry>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </visual>
  <collision>
    <geometry>
        <box size="${body_link_x_dim} ${body_link_y_dim} ${body_link_z_dim}"/>
    </geometry>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </collision>
  <inertial>
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <mass value="${base_density*body_link_x_dim*body_link_y_dim*body_link_z_dim}"/>
    <inertia ixx="${1.0/12.0*(base_density*body_link_x_dim*body_link_y_dim*body_link_z_dim)*(body_link_y_dim*body_link_y_dim+body_link_z_dim*body_link_z_dim)}" ixy="0" ixz="0" iyx="0" iyy="${1.0/12.0*(base_density*body_link_x_dim*body_link_y_dim*body_link_z_dim)*(body_link_x_dim*body_link_x_dim+body_link_z_dim*body_link_z_dim)}" iyz="0" izx="0" izy="0" izz="${1.0/12.0*(base_density*body_link_x_dim*body_link_y_dim*body_link_z_dim)*(body_link_x_dim*body_link_x_dim+body_link_y_dim*body_link_y_dim)}"/>
  </inertial>
</link>


<!-- Back right wheel link and joint -->
<joint name="wheel_right_back_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_right_back_link"/>
    <origin xyz="${-base_link_x_dim/2+1.2*wheel_link_radius} ${-base_link_y_dim/2-wheel_link_length/2} ${wheel_link_z_location}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="1000" velocity="1000"/>
    <dynamics damping="1.0" friction="1.0"/>
</joint>
<link name="wheel_right_back_link">
    <visual>
        <geometry>
            <cylinder length="${wheel_link_length}" radius="${wheel_link_radius}"/>
        </geometry>
        <origin rpy="${pi/2} 0 0" xyz="0 0 0"/>
    </visual>
    <collision>
        <geometry>
            <cylinder length="${wheel_link_length}" radius="${wheel_link_radius}"/>
        </geometry>
        <origin rpy="${pi/2} 0 0" xyz="0 0 0"/>
    </collision>
    <xacro:inertia_wheel/>
</link>

<!-- Back left wheel link and joint -->
<joint name="wheel_left_back_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_left_back_link"/>
    <origin xyz="${-base_link_x_dim/2+1.2*wheel_link_radius} ${base_link_y_dim/2+wheel_link_length/2} ${wheel_link_z_location}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="1000" velocity="1000"/>
    <dynamics damping="1.0" friction="1.0"/>
</joint>
<link name="wheel_left_back_link">
    <visual>
        <geometry>
            <cylinder length="${wheel_link_length}" radius="${wheel_link_radius}"/>
        </geometry>
        <origin rpy="${pi/2} 0 0" xyz="0 0 0"/>
    </visual>
    <collision>
        <geometry>
            <cylinder length="${wheel_link_length}" radius="${wheel_link_radius}"/>
        </geometry>
        <origin rpy="${pi/2} 0 0" xyz="0 0 0"/>
    </collision>
    <xacro:inertia_wheel/>
</link>

<!-- Front right wheel link and joint -->
<joint name="wheel_right_front_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_right_front_link"/>
    <origin xyz="${base_link_x_dim/2-1.2*wheel_link_radius} ${-base_link_y_dim/2-wheel_link_length/2} ${wheel_link_z_location}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="1000" velocity="1000"/>
    <dynamics damping="1.0" friction="1.0"/>
</joint>
<link name="wheel_right_front_link">
    <visual>
        <geometry>
            <cylinder length="${wheel_link_length}" radius="${wheel_link_radius}"/>
        </geometry>
        <origin rpy="${pi/2} 0 0" xyz="0 0 0"/>
    </visual>
    <collision>
        <geometry>
            <cylinder length="${wheel_link_length}" radius="${wheel_link_radius}"/>
        </geometry>
        <origin rpy="${pi/2} 0 0" xyz="0 0 0"/>
    </collision>
    <xacro:inertia_wheel/>
</link>

<!-- Front left wheel link and joint -->
<joint name="wheel_left_front_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_left_front_link"/>
    <origin xyz="${base_link_x_dim/2-1.2*wheel_link_radius} ${base_link_y_dim/2+wheel_link_length/2} ${wheel_link_z_location}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="1000" velocity="1000"/>
    <dynamics damping="1.0" friction="1.0"/>
</joint>
<link name="wheel_left_front_link">
    <visual>
        <geometry>
            <cylinder length="${wheel_link_length}" radius="${wheel_link_radius}"/>
        </geometry>
        <origin rpy="${pi/2} 0 0" xyz="0 0 0"/>
    </visual>
    <collision>
        <geometry>
            <cylinder length="${wheel_link_length}" radius="${wheel_link_radius}"/>
        </geometry>
        <origin rpy="${pi/2} 0 0" xyz="0 0 0"/>
    </collision>
    <xacro:inertia_wheel/>
</link>

</robot>